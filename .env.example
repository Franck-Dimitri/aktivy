# ── PRODUCTION ─────────────────────────────────────────────────────────────
# Valeurs ci-dessous pour le poste de développement. Sur le serveur, OBLIGATOIREMENT :
#   APP_ENV=production   (sinon : comptes de démo sur la page de connexion, seeder de démo autorisé,
#                         règles de mot de passe allégées)
#   APP_DEBUG=false      (sinon : code et secrets affichés sur les pages d'erreur)
#   LOG_LEVEL=warning
#   APP_URL=https://…    (https : historique chiffré, HSTS, cookies sécurisés)
#   SESSION_SECURE_COOKIE=true
# ────────────────────────────────────────────────────────────────────────────
APP_NAME=Motriks
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Douala

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Un fichier par jour, 14 jours gardés (LOG_DAILY_DAYS) : le journal ne grossit plus sans fin
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=motriks
DB_USERNAME=motriks
DB_PASSWORD=motriks

# Indicatif ajouté aux numéros saisis sans préfixe international
PHONE_COUNTRY_CODE=237

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (https) : true, le cookie de session ne part jamais en clair
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Support (centre d'aide) : adresse qui reçoit les demandes (par défaut MAIL_FROM_ADDRESS)
# et numéro WhatsApp au format international sans « + » ; vide = numéro de la plateforme (237657439465)
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=237657439465

# Mentions de Motriks sur les factures d'abonnement (NIU et RCCM affichés s'ils sont renseignés)
BILLING_NAME=Motriks
BILLING_ADDRESS=
BILLING_CITY="Yaoundé, Cameroun"
BILLING_PHONE="+237 657 43 94 65"
BILLING_EMAIL=
BILLING_NIU=
BILLING_RCCM=
# Moyens de paiement indiqués sur les factures (numéro marchand, IBAN, instructions) ; vides = non affichés
BILLING_ORANGE_MONEY=
BILLING_MTN_MOMO=
BILLING_BANK=
BILLING_CARD=
# Conditions ou mention légale en bas de facture (ex. « TVA non applicable »)
BILLING_TERMS=

# Notifications push (WebPush) : clés générées avec « php artisan webpush:vapid » (à garder secrètes).
# Sans clé publique, le bouton « Activer les notifications » n'est pas proposé.
VAPID_SUBJECT="mailto:${MAIL_FROM_ADDRESS}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Bot Telegram ───────────────────────────────────────────────────────────
BACKUP_PASSPHRASE=           # Chiffre les sauvegardes (ex: openssl rand -base64 32) ; à garder aussi hors du serveur
BACKUP_DISK=                 # Disque hors du serveur (config/filesystems.php) où chaque sauvegarde est copiée, ex. s3
TELEGRAM_BOT_TOKEN=          # Token du bot obtenu via @BotFather
TELEGRAM_CHAT_ID=            # ID du chat/groupe à notifier (sauvegarde auto, rapport matin)
TELEGRAM_WEBHOOK_SECRET=     # Chaîne aléatoire pour sécuriser le webhook (ex: openssl rand -hex 32)
TELEGRAM_ALLOWED_IDS=        # IDs Telegram autorisés à utiliser le bot, séparés par des virgules
