includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    # Erreurs existantes au 17/11/2026, figées : la CI bloque toute nouvelle erreur ; à résorber petit à petit
    - phpstan-baseline.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Les types des commentaires (@property, relations) ne valent pas preuve : une relation vers un élément
    # supprimé, une recherche dans une liste peuvent donner null. Sans cela, PHPStan poussait à retirer des
    # « ?-> » nécessaires (erreurs 500 sur « Mes ventes » en novembre 2026).
    treatPhpDocTypesAsCertain: false

    # « ?-> » jugé inutile : garder une protection inutile ne coûte rien, la retirer à tort casse une page
    ignoreErrors:
        - identifier: nullsafe.neverNull
